@page "/admin/news/categories"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net
@using SilverbridgeWeb.WebUI.Services.ApiClients
@using SilverbridgeWeb.WebUI.Services.Authorization
@inject NewsApiClient NewsApiClient
@inject UsersApiClient UsersApiClient
@inject ISnackbar Snackbar

<PageTitle>News Categories - Silverbridge Harps GAC</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="category-page">
    <PageHeader Title="News Categories"
                Eyebrow="Communications"
                Description="Organise articles into clear, reusable categories.">
        <Actions>
            <MudButton Href="/admin/news" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                Back to news
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <StatePanel Title="Loading categories"
                    Description="Preparing your news categories."
                    Icon="@Icons.Material.Outlined.Category" />
    }
    else if (!_canManageNews)
    {
        <StatePanel Title="Access unavailable"
                    Description="You do not have permission to manage news categories."
                    Icon="@Icons.Material.Outlined.Lock"
                    IconColor="Color.Error"
                    Role="alert" />
    }
    else
    {
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Outlined="true" Elevation="0" Class="category-card">
                    <MudCardContent>
                        <SectionHeader Title="Create Category" Description="Add a new article category." />
                        <EditForm Model="_model" OnValidSubmit="CreateCategoryAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_model.Name"
                                          Label="Category name"
                                          For="@(() => _model.Name)"
                                          Required="true" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="@_isSaving"
                                       Class="category-submit">
                                Create Category
                            </MudButton>
                        </EditForm>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Outlined="true" Elevation="0" Class="category-card category-table-card">
                <MudTable T="NewsCategoryResponse" Items="_categories" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Size="Size.Small" Color="@(context.IsArchived ? Color.Default : Color.Success)">
                                @(context.IsArchived ? "Archived" : "Active")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <StatePanel Title="No categories yet"
                                    Description="Create a category to organise your first article."
                                    Icon="@Icons.Material.Outlined.Category" />
                    </NoRecordsContent>
                </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private List<NewsCategoryResponse> _categories = [];
    private CategoryFormModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canManageNews;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            UserRolesResponse? rolesResponse = await UsersApiClient.GetRolesAsync();
            IReadOnlyList<string> roles = rolesResponse?.Roles ?? [];
            _canManageNews = roles.Contains(AppRoles.Administrator, StringComparer.Ordinal) ||
                             roles.Contains(AppRoles.CommunicationsOfficer, StringComparer.Ordinal);

            if (!_canManageNews)
            {
                _categories = [];
                return;
            }

            _categories = (await NewsApiClient.GetCategoriesAsync())?
                .OrderBy(category => category.Name)
                .ToList() ?? [];
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized || ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _canManageNews = false;
            _categories = [];
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load categories: {ex.Message}";
            _categories = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateCategoryAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            await NewsApiClient.CreateCategoryAsync(new CreateNewsCategoryRequest(_model.Name.Trim()));
            Snackbar.Add("Category created successfully.", Severity.Success);
            _model = new CategoryFormModel();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create category: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class CategoryFormModel
    {
        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
