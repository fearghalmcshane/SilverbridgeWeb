@page "/admin/users"
@attribute [Authorize]
@inject UsersApiClient UsersApiClient

@using SilverbridgeWeb.WebUI.Services.ApiClients
@using SilverbridgeWeb.WebUI.Services.Authorization

<PageTitle>User Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="user-management-page">
    <PageHeader Title="User Management"
                Eyebrow="Administration"
                Description="Assign and remove club access roles using a member's unique user ID." />

    @if (_loading)
    {
        <StatePanel Title="Loading user management"
                    Description="Checking your administrator access."
                    Icon="@Icons.Material.Outlined.ManageAccounts" />
    }
    else if (!_isAdmin)
    {
        <StatePanel Title="Access unavailable"
                    Description="You do not have permission to access this page."
                    Icon="@Icons.Material.Outlined.Lock"
                    IconColor="Color.Error"
                    Role="alert" />
    }
    else
    {
        <MudCard Outlined="true" Elevation="0" Class="role-card">
            <MudCardContent>
                <SectionHeader Title="Role Assignment"
                               Description="Select a role and apply it to the specified user." />
                @if (_actionMessage is not null)
                {
                    <MudAlert Severity="@_actionSeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _actionMessage = null)">@_actionMessage</MudAlert>
                }
                <MudTextField @bind-Value="_userIdInput"
                              Label="User ID"
                              Placeholder="e.g. 00000000-0000-0000-0000-000000000000"
                              HelperText="The GUID of the user to manage"
                              Class="mb-3" />
                <MudSelect @bind-Value="_selectedRole" Label="Role" Class="mb-2">
                    <MudSelectItem Value="@(AppRoles.Administrator)">Administrator</MudSelectItem>
                    <MudSelectItem Value="@(AppRoles.BookingAdministrator)">Booking Administrator</MudSelectItem>
                    <MudSelectItem Value="@(AppRoles.CommunicationsOfficer)">Communications Officer</MudSelectItem>
                    <MudSelectItem Value="@(AppRoles.Member)">Member</MudSelectItem>
                </MudSelect>
            </MudCardContent>
            <MudCardActions Class="role-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="AssignRoleAsync"
                           Disabled="@_actionLoading">
                    Assign Role
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                OnClick="@(() => _showRemoveConfirmation = true)"
                           Disabled="@_actionLoading"
                StartIcon="@Icons.Material.Filled.PersonRemove">
                    Remove Role
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

<MudDialog @bind-Visible="_showRemoveConfirmation">
    <TitleContent>
        <MudText Typo="Typo.h6">Remove user role?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            Remove the <strong>@_selectedRole</strong> role from this user? Their access may change immediately.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showRemoveConfirmation = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmRemoveRoleAsync">
            Remove Role
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private bool _isAdmin;
    private bool _actionLoading;
    private bool _showRemoveConfirmation;
    private string? _actionMessage;
    private Severity _actionSeverity = Severity.Info;
    private string _userIdInput = string.Empty;
    private string _selectedRole = AppRoles.Administrator;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            UserRolesResponse? rolesResponse = await UsersApiClient.GetRolesAsync();
            _isAdmin = rolesResponse?.Roles.Contains(AppRoles.Administrator) ?? false;
        }
        catch (Exception)
        {
            _isAdmin = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AssignRoleAsync()
    {
        if (!Guid.TryParse(_userIdInput, out Guid userId))
        {
            _actionMessage = "Please enter a valid user ID.";
            _actionSeverity = Severity.Warning;
            return;
        }

        _actionLoading = true;
        _actionMessage = null;
        try
        {
            await UsersApiClient.AssignRoleAsync(userId, _selectedRole);
            _actionMessage = $"Successfully assigned '{_selectedRole}' role to user.";
            _actionSeverity = Severity.Success;
        }
        catch (Exception)
        {
            _actionMessage = "Failed to assign role. The user may not exist or already has this role.";
            _actionSeverity = Severity.Error;
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private async Task RemoveRoleAsync()
    {
        if (!Guid.TryParse(_userIdInput, out Guid userId))
        {
            _actionMessage = "Please enter a valid user ID.";
            _actionSeverity = Severity.Warning;
            return;
        }

        _actionLoading = true;
        _actionMessage = null;
        try
        {
            await UsersApiClient.RemoveRoleAsync(userId, _selectedRole);
            _actionMessage = $"Successfully removed '{_selectedRole}' role from user.";
            _actionSeverity = Severity.Success;
        }
        catch (Exception)
        {
            _actionMessage = "Failed to remove role. The user may not exist or does not have this role.";
            _actionSeverity = Severity.Error;
        }
        finally
        {
            _actionLoading = false;
        }
    }

    private async Task ConfirmRemoveRoleAsync()
    {
        _showRemoveConfirmation = false;
        await RemoveRoleAsync();
    }
}
