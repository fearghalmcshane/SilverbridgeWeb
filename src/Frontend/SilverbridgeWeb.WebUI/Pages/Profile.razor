@page "/profile"
@attribute [Authorize]
@inject UsersApiClient UsersApiClient

<PageTitle>My Profile</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="profile-page">
    <PageHeader Eyebrow="Your account"
                Title="My profile"
                Description="Your Silverbridge Harps account details." />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading profile" />
    }
    else if (_error is not null)
    {
        <StatePanel Title="Profile unavailable"
                    Description="@_error"
                    Icon="@Icons.Material.Outlined.PersonOff"
                    IconColor="Color.Error"
                    Role="alert" />
    }
    else if (_profile is not null)
    {
        <MudCard Elevation="0" Class="profile-card">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        @_profile.FirstName.FirstOrDefault()@_profile.LastName.FirstOrDefault()
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText HtmlTag="h2" Typo="Typo.h6">@_profile.FirstName @_profile.LastName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_profile.Email</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.Person" Text="First Name" SecondaryText="@_profile.FirstName" />
                    <MudListItem Icon="@Icons.Material.Filled.Person" Text="Last Name" SecondaryText="@_profile.LastName" />
                    <MudListItem Icon="@Icons.Material.Filled.Email" Text="Email" SecondaryText="@_profile.Email" />
                </MudList>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@using SilverbridgeWeb.WebUI.Services.ApiClients
@code {
    private UserProfileResponse? _profile;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await UsersApiClient.GetProfileAsync();
            if (_profile is null)
            {
                _error = "Profile not found. Your account may not have synced yet — try signing out and back in.";
            }
        }
        catch (Exception)
        {
            _error = "Failed to load profile. Please try again later.";
        }
        finally
        {
            _loading = false;
        }
    }
}
