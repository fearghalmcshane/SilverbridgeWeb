@page "/contact"
@using System.ComponentModel.DataAnnotations

<PageTitle>Contact Us</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="contact-page">
    <PageHeader Eyebrow="We would love to hear from you"
                Title="Contact us"
                Description="Send the club a message and we will get back to you as soon as possible." />

    <div class="contact-layout">
        <aside class="contact-aside" aria-labelledby="contact-aside-title">
            <MudIcon Icon="@Icons.Material.Outlined.Forum" Size="Size.Large" aria-hidden="true" />
            <h2 id="contact-aside-title">Start a conversation</h2>
            <p>Questions about teams, volunteering, facilities or club life are always welcome.</p>
        </aside>

        <section class="contact-form" aria-label="Contact form">
            <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <MudTextField @bind-Value="model.Name" Label="Name" For="@(() => model.Name)"
                              Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="model.Email" Label="Email address" For="@(() => model.Email)"
                              InputType="InputType.Email" Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="model.Message" Label="How can we help?" Lines="6"
                              For="@(() => model.Message)" Variant="Variant.Outlined" Required="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                           EndIcon="@Icons.Material.Filled.Send">
                    Send message
                </MudButton>
            </EditForm>
        </section>
    </div>
</MudContainer>

@code {
    private readonly ContactForm model = new();

    public sealed class ContactForm
    {
        [Required]
        public string? Name { get; set; }

        [Required]
        [EmailAddress]
        public string? Email { get; set; }

        [Required]
        public string? Message { get; set; }
    }

    private void HandleValidSubmit()
    {
        Console.WriteLine($"Name: {model.Name}, Email: {model.Email}, Message: {model.Message}");
    }
}
