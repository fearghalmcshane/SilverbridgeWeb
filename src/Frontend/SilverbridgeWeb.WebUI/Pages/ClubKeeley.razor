@page "/clubkeeley"

<PageTitle>Club Keeley</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="keeley-page">
    <PageHeader Eyebrow="Support the club"
                Title="Club Keeley"
                Description="A monthly benefactor scheme helping Silverbridge Harps maintain our facilities and deliver ambitious projects." />

    <div class="keeley-layout">
        <section class="keeley-story" aria-labelledby="keeley-story-title">
            <h2 id="keeley-story-title">Make a lasting contribution</h2>
            <p>
                Club Keeley members have directly supported the maintenance and upkeep of the club,
                while making larger projects possible. The suggested contribution is £20 per month.
            </p>
            <p>
                Submit the interest form and a member of the Club Keeley team will contact you.
                Thank you for supporting Silverbridge Harps.
            </p>
            <MudButton Href="https://forms.office.com/Pages/ResponsePage.aspx?id=hrxFrNSvpUKfwz6H4bd_zi5vfvqth6FMpUr8ZnlRCeJUQTlDTzVIQklQWDRNVVlSQzRUWFRWSks2Qy4u"
                       Target="_blank"
                       Rel="noopener noreferrer"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.OpenInNew">
                Express your interest
                <span class="visually-hidden">(opens in a new tab)</span>
            </MudButton>
        </section>

        <section class="keeley-benefits" aria-labelledby="keeley-benefits-title">
            <h2 id="keeley-benefits-title">Member benefits</h2>
            <ul>
                <li><MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" aria-hidden="true" />Entry into a monthly £100 prize draw</li>
                <li><MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" aria-hidden="true" />Annual ticket for the Armagh £100 Club Draw</li>
                <li><MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" aria-hidden="true" />Annual entry into the Croke Park Club Draw</li>
                <li><MudIcon Icon="@Icons.Material.Outlined.Checkroom" aria-hidden="true" />Exclusive O'Neills Club Keeley jacket</li>
            </ul>
        </section>
    </div>
</MudContainer>
