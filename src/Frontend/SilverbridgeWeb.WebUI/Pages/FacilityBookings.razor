        }
    }

    private async Task SubmitBookingAsync()
    {
        if (_newBookingFacilityId == Guid.Empty ||
            string.IsNullOrWhiteSpace(_newBookingTitle) ||
            string.IsNullOrWhiteSpace(_newBookingBookerName) ||
            string.IsNullOrWhiteSpace(_newBookingContactName) ||
            _newBookingStartDate is null ||
            _newBookingStartTime is null ||
            _newBookingEndDate is null ||
            _newBookingEndTime is null)
        {
            Snackbar.Add("Complete all required booking fields.", Severity.Warning);
            return;
        }

        if (!_editingBookingId.HasValue &&
            _newBookingIsRecurring &&
            (_newBookingRecurrenceDays.Count == 0 || _newBookingRecurrenceEndDate is null))
        {
            Snackbar.Add("Select at least one repeat day and a recurrence end date.", Severity.Warning);
            return;
        }

        if (!_editingBookingId.HasValue &&
            _newBookingIsRecurring &&
            _newBookingStartDate.HasValue &&
            _newBookingRecurrenceEndDate > _newBookingStartDate.Value.AddDays(365))
        {
            Snackbar.Add("A recurring booking can cover at most 366 days.", Severity.Warning);
            return;
        }

        DateTime startsAt = ToUtc(_newBookingStartDate.Value.Date.Add(_newBookingStartTime.Value));
        DateTime endsAt = ToUtc(_newBookingEndDate.Value.Date.Add(_newBookingEndTime.Value));

        if (endsAt <= startsAt)
        {
            Snackbar.Add("The booking end must be after its start.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            if (_editingBookingId.HasValue)
            {
                await BookingsClient.UpdateBookingAsync(
                    _editingBookingId.Value,
                    new UpdateBookingRequest(
                        _newBookingFacilityId,
                        _newBookingTitle.Trim(),
                        _newBookingContactName.Trim(),
                        startsAt,
                        endsAt,
                        _newBookingIsPublic));
            }
            else
            {
                await BookingsClient.CreateBookingAsync(new CreateBookingRequest(
                    _newBookingFacilityId,
                    _newBookingTitle.Trim(),
                    _newBookingContactName.Trim(),
                    startsAt,
                    endsAt,
                    _newBookingIsPublic,
                    _newBookingIsRecurring,
                    _newBookingRecurrenceDays.ToList(),
                    _newBookingRecurrenceEndDate));
            }

            _showCreateBookingDialog = false;
            Snackbar.Add(
                _editingBookingId.HasValue
                    ? $"Booking '{_newBookingTitle}' updated."
                    : $"Booking '{_newBookingTitle}' created.",
                Severity.Success);
            _editingBookingId = null;
            await LoadDataAsync();
        }
        catch (HttpRequestException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static DateTime GetWeekStart(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }

    private static int GetMondayBasedDayOfWeek(DateTime date) =>
        ((int)date.DayOfWeek + 6) % 7 + 1;

    private static DateTime ToBookingTime(DateTime utcDateTime) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utcDateTime, DateTimeKind.Utc),
            BookingTimeZone);

    private static DateTime ToUtc(DateTime bookingDateTime) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(bookingDateTime, DateTimeKind.Unspecified),
            BookingTimeZone);

    private static readonly TimeZoneInfo BookingTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Dublin");

    private enum CalendarView
    {
        Week,
        Month,
        Range
    }
}
