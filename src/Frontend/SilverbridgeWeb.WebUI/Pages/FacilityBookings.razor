        {
            return;
        }

        _isSaving = true;
        try
        {
            await BookingsClient.ApproveBookingAsync(_selectedBooking.Id);
            Snackbar.Add($"Booking '{_selectedBooking.Title}' approved.", Severity.Success);
            _showBookingDetailsDialog = false;
