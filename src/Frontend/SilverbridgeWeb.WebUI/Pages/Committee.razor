@page "/committee"

<PageTitle>Committee</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="committee-page">
    <PageHeader Eyebrow="Club leadership"
                Title="Committee"
                Description="Meet the volunteers working together to guide and support Silverbridge Harps." />

    <section class="committee-list" aria-label="Committee members">
        @foreach (CommitteeMember member in Members)
        {
            <article class="committee-member">
                <div class="committee-member__avatar" aria-hidden="true">@GetInitials(member.Name)</div>
                <div>
                    <p>@member.Position</p>
                    <h2>@member.Name</h2>
                </div>
            </article>
        }
    </section>
</MudContainer>

@code {
    private static readonly CommitteeMember[] Members =
    [
        new("Chairperson", "Thomas McKeown"),
        new("Vice Chairperson", "Damien Finnegan"),
        new("Secretary", "Roby McMahon"),
        new("Assistant Secretary", "Aidan Murphy"),
        new("Assistant Secretary", "Jarlath Burns"),
        new("Treasurer", "Fearghal McShane"),
        new("Assistant Treasurer", "Tony McKenna"),
        new("PRO", "Catherine O'Hare"),
        new("Assistant PRO", "Caoimhe Shevlin"),
        new("Registrar", "Edwina Murphy"),
        new("Children's Officer", "Rosie Burns"),
        new("Coaching Officer", "Michael Lavelle"),
        new("Irish Language and Culture Officer", "Lorcan Burns"),
        new("Grants Officer", "David Murphy")
    ];

    private static string GetInitials(string name)
    {
        string[] names = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return $"{names[0][0]}{names[^1][0]}";
    }

    private sealed record CommitteeMember(string Position, string Name);
}
