@page "/involved"

<PageTitle>Get Involved</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="content-page">
    <PageHeader Eyebrow="Volunteer with us"
                Title="Get involved"
                Description="Share your time and skills, meet new people and help Silverbridge Harps thrive." />

    <section class="role-grid" aria-label="Volunteering opportunities">
        @foreach (VolunteerRole role in Roles)
        {
            <article class="role-card">
                <MudIcon Icon="@role.Icon" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
                <h2>@role.Title</h2>
                <p>@role.Description</p>
            </article>
        }
    </section>

    <section class="callout" aria-labelledby="volunteer-callout">
        <div>
            <h2 id="volunteer-callout">Ready to lend a hand?</h2>
            <p>Tell us what interests you and a member of the club will be in touch.</p>
        </div>
        <MudButton Href="/contact" Variant="Variant.Filled" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">
            Contact us
        </MudButton>
    </section>
</MudContainer>

@code {
    private static readonly VolunteerRole[] Roles =
    [
        new("Coaching team", "Help train and encourage players across our age groups and ability levels.", Icons.Material.Outlined.Sports),
        new("Bar staff", "Help create a friendly, welcoming clubhouse atmosphere for members and guests.", Icons.Material.Outlined.LocalBar),
        new("Hospitality team", "Support match days and events with set-up, service and a warm welcome.", Icons.Material.Outlined.Groups),
        new("Pitch maintenance", "Keep our grounds ready for play through lining, mowing and general upkeep.", Icons.Material.Outlined.Grass),
        new("Fundraising team", "Plan activities and raise vital funds for the club and wider community.", Icons.Material.Outlined.VolunteerActivism)
    ];

    private sealed record VolunteerRole(string Title, string Description, string Icon);
}
