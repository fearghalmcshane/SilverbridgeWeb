@page "/news"
@using SilverbridgeWeb.WebUI.Services.ApiClients
@inject NewsApiClient NewsApiClient

<PageTitle>News - Silverbridge Harps GAC</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="news-page">
    <PageHeader Eyebrow="From around the club"
                Title="Club news"
                Description="Latest updates, announcements and match-day stories from Silverbridge Harps." />

    <section class="news-filter" aria-label="Filter news articles">
        <div>
            <MudSelect T="Guid?" Label="Category" Value="_selectedCategoryId" ValueChanged="OnCategoryChanged" Clearable="true">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">All categories</MudSelectItem>
                @foreach (NewsCategoryResponse category in _categories)
                {
                    <MudSelectItem T="Guid?" Value="@category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </section>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading news articles" />
    }
    else if (_errorMessage is not null)
    {
        <StatePanel Title="News is unavailable"
                    Description="@_errorMessage"
                    Icon="@Icons.Material.Outlined.CloudOff"
                    IconColor="Color.Error"
                    Role="alert" />
    }
    else if (_articles.Count == 0)
    {
        <StatePanel Title="No articles found"
                    Description="Try choosing another category or check back soon."
                    Icon="@Icons.Material.Outlined.Article" />
    }
    else
    {
        <section class="news-grid" aria-label="News articles">
            @foreach (NewsArticleSummaryResponse article in _articles)
            {
                <article class="news-card">
                    <MudCard Elevation="0" Class="news-card__surface">
                        <div class="news-card__media">
                            <div class="news-card__placeholder" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Newspaper" />
                            </div>
                        @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                        {
                            <img src="@article.FeaturedImageUrl" alt="" loading="lazy"
                                 onerror="this.hidden=true" />
                        }
                        </div>
                        <MudCardContent>
                            <div class="news-card__meta">
                                <span>@article.CategoryName</span>
                                @if (article.PublishedAtUtc.HasValue)
                                {
                                    <time datetime="@article.PublishedAtUtc.Value.ToString("O")">
                                        @article.PublishedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    </time>
                                }
                            </div>
                            <h2>@article.Title</h2>
                            @if (article.ArticleType == NewsArticleType.MatchReport)
                            {
                                <p class="news-card__score">
                                    @article.HomeTeam @FormatScore(article.HomeGoals, article.HomePoints)
                                    <span aria-hidden="true">—</span>
                                    @FormatScore(article.AwayGoals, article.AwayPoints) @article.AwayTeam
                                </p>
                            }
                            <p class="news-card__summary">@article.Summary</p>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/news/{article.Slug}")"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ArrowForward">
                                Read article
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </article>
            }
        </section>

        @if (TotalPages > 1)
        {
            <MudPagination Class="news-pagination"
                           Count="@TotalPages"
                           Selected="@_currentPage"
                           SelectedChanged="OnPageChanged" />
        }
    }
</MudContainer>

@code {
    private const int PageSize = 9;

    private List<NewsCategoryResponse> _categories = [];
    private List<NewsArticleSummaryResponse> _articles = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private Guid? _selectedCategoryId;
    private int _currentPage = 1;
    private int _totalCount;

    private int TotalPages => _totalCount <= 0
        ? 1
        : (int)Math.Ceiling(_totalCount / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            Task<IReadOnlyCollection<NewsCategoryResponse>?> categoriesTask = NewsApiClient.GetCategoriesAsync();
            Task<NewsArticleListResponse?> articlesTask = NewsApiClient.GetArticlesAsync(
                _currentPage,
                PageSize,
                _selectedCategoryId,
                includeAllStatuses: false);

            await Task.WhenAll(categoriesTask, articlesTask);

            _categories = categoriesTask.Result?
                .Where(category => !category.IsArchived)
                .OrderBy(category => category.Name)
                .ToList() ?? [];

            NewsArticleListResponse? response = articlesTask.Result;
            _articles = response?.Articles.ToList() ?? [];
            _totalCount = response?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load news articles: {ex.Message}";
            _categories = [];
            _articles = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnCategoryChanged(Guid? categoryId)
    {
        _selectedCategoryId = categoryId;
        _currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadAsync();
    }

    private static string FormatScore(int? goals, int? points) => $"{goals ?? 0}-{points ?? 0}";
}
