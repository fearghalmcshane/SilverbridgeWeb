@using SilverbridgeWeb.WebUI.Services.ApiClients
@using SilverbridgeWeb.WebUI.Services.Authorization
@inject UsersApiClient UsersApiClient

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>
    <MudNavLink Href="/news" Icon="@Icons.Material.Filled.Article" Match="NavLinkMatch.Prefix">News</MudNavLink>

    <MudNavGroup Title="Fixtures & Results" Expanded="true">
        <MudNavLink Href="/fixtures" Icon="@Icons.Material.Filled.SportsSoccer" Match="NavLinkMatch.Prefix">Fixtures</MudNavLink>
        @* <MudNavLink Href="/competitions" Icon="@Icons.Material.Filled.EmojiEvents" Match="NavLinkMatch.Prefix">Competitions</MudNavLink> *@
    </MudNavGroup>

    <AuthorizeView>
        <Authorized>
            <MudNavGroup Title="Authorised" Expanded="true">
                <MudNavLink Href="/categories" Icon="@Icons.Material.Filled.Category" Match="NavLinkMatch.Prefix">Categories</MudNavLink>
            </MudNavGroup>

            @if (_canManageNews || _isAdmin)
            {
                <MudNavGroup Title="Administration" Expanded="true">
                    <MudNavLink Href="/admin/news" Icon="@Icons.Material.Filled.Feed" Match="NavLinkMatch.Prefix">Manage News</MudNavLink>
                    <MudNavLink Href="/admin/news/categories" Icon="@Icons.Material.Filled.Category" Match="NavLinkMatch.Prefix">News Categories</MudNavLink>

                    @if (_isAdmin)
                    {
                        <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.AdminPanelSettings" Match="NavLinkMatch.Prefix">User Management</MudNavLink>
                    }
                </MudNavGroup>
            }
        </Authorized>
    </AuthorizeView>

    <MudNavGroup Title="Facilities" Expanded="true">
        <MudNavLink Href="/gym" Icon="@Icons.Material.Filled.FitnessCenter" Match="NavLinkMatch.Prefix">Gym</MudNavLink>
        <MudNavLink Href="/clubkeeley" Icon="@Icons.Material.Filled.WorkspacePremium" Match="NavLinkMatch.Prefix">Club Keeley</MudNavLink>
        <MudNavLink Href="/facility-bookings" Icon="@Icons.Material.Filled.CalendarMonth" Match="NavLinkMatch.Prefix">Facility Bookings</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="About Us" Expanded="true">
        <MudNavLink Href="/committee" Icon="@Icons.Material.Filled.Contacts" Match="NavLinkMatch.Prefix">Committee</MudNavLink>
        <MudNavLink Href="/involved" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.Prefix">Get Involved</MudNavLink>
        <MudNavLink Href="/contact" Icon="@Icons.Material.Filled.ContactSupport" Match="NavLinkMatch.Prefix">Contact Us</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="External Services" Expanded="true">
        <MudNavLink Href="https://silverbridge.clubzap.com/draws" Target="_blank" Icon="@Icons.Material.Filled.Money" Match="NavLinkMatch.All">Lotto</MudNavLink>
        <MudNavLink Href="https://www.oneills.com/uk_en/shop-by-team/gaa/ireland/silverbridge-harps.html" Target="_blank" Icon="@Icons.Material.Filled.ShoppingCart" Match="NavLinkMatch.All">O'Neills Club Shop</MudNavLink>
        <MudNavLink Href="https://playr-fit.com/collections/silverbridge-clg" Target="_blank" Icon="@Icons.Material.Filled.ShoppingCart" Match="NavLinkMatch.All">PlayrFit Club Shop</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {
    private bool _isAdmin;
    private bool _canManageNews;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        AuthenticationState authState = await AuthenticationState;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            UserRolesResponse? rolesResponse = await UsersApiClient.GetRolesAsync();
            IReadOnlyList<string> roles = rolesResponse?.Roles ?? [];
            _isAdmin = roles.Contains(AppRoles.Administrator, StringComparer.Ordinal);
            _canManageNews = _isAdmin || roles.Contains(AppRoles.CommunicationsOfficer, StringComparer.Ordinal);
        }
        catch (Exception)
        {
            _isAdmin = false;
            _canManageNews = false;
        }
    }
}
