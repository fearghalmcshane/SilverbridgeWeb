@inherits LayoutComponentBase
@implements IDisposable
@using SilverbridgeWeb.WebUI.Services.Theme
@using SilverbridgeWeb.WebUI.Theme
@inject ThemePreferenceService ThemePreferenceService

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-header" role="banner">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle primary navigation" />
        <a href="/" class="brand-link" aria-label="Silverbridge Harps home">
            <MudAvatar Size="Size.Medium" Class="club-avatar">
                <MudImage ObjectFit="ObjectFit.Contain" Src="images/bridge.jpg" Alt="" />
            </MudAvatar>
            <span class="brand-wordmark">
                <strong>Silverbridge Harps</strong>
                <small>Gaelic Athletic Club</small>
            </span>
        </a>
        <MudSpacer />
        <LoginDisplay />
        <MudMenu Icon="@ThemeIcon"
                 IconColor="Color.Inherit"
                 AriaLabel="@ThemeMenuLabel"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="@(() => SetThemePreferenceAsync(ThemePreference.System))">
                <MudIcon Icon="@GetPreferenceIcon(ThemePreference.System)" Class="mr-3" />
                Use system setting
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => SetThemePreferenceAsync(ThemePreference.Light))">
                <MudIcon Icon="@GetPreferenceIcon(ThemePreference.Light)" Class="mr-3" />
                Light mode
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => SetThemePreferenceAsync(ThemePreference.Dark))">
                <MudIcon Icon="@GetPreferenceIcon(ThemePreference.Dark)" Class="mr-3" />
                Dark mode
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               Class="app-drawer"
               aria-label="Primary navigation">
        <NavMenu />
    </MudDrawer>

    <div class="app-content-column">
        <MudMainContent id="main-content" tabindex="-1" Class="app-main">
            @Body
        </MudMainContent>

        <footer class="site-footer">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                <div class="footer-content">
                    <div>
                        <MudText Typo="Typo.h6">Silverbridge Harps GAC</MudText>
                        <MudText Typo="Typo.body2" Class="footer-copy">
                            Community, sport and belonging in the heart of Silverbridge.
                        </MudText>
                        <MudText Typo="Typo.caption" Class="footer-copy">
                            © @DateTime.Now.Year Silverbridge Harps GAC
                        </MudText>
                    </div>
                    <nav class="social-links" aria-label="Silverbridge social media">
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Primary"
                                       Href="https://www.facebook.com/SilverbridgeGaa" Target="_blank"
                                       rel="noopener noreferrer" aria-label="Silverbridge Harps on Facebook" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Color="Color.Primary"
                                       Href="https://www.instagram.com/silverbridgegaa" Target="_blank"
                                       rel="noopener noreferrer" aria-label="Silverbridge Harps on Instagram" />
                        <MudIconButton Icon="@Icons.Custom.Brands.X" Color="Color.Primary"
                                       Href="https://x.com/silverbridgegaa" Target="_blank"
                                       rel="noopener noreferrer" aria-label="Silverbridge Harps on X" />
                        <MudIconButton Icon="@Icons.Custom.Brands.YouTube" Color="Color.Primary"
                                       Href="@YouTubeUrl" Target="_blank"
                                       rel="noopener noreferrer" aria-label="Silverbridge Harps on YouTube" />
                        <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp" Color="Color.Primary"
                                       Href="https://chat.whatsapp.com/LSLEuKCokSm5UCbqDRNMIt" Target="_blank"
                                       rel="noopener noreferrer" aria-label="Silverbridge Harps WhatsApp community" />
                    </nav>
                </div>
            </MudContainer>
        </footer>
    </div>
</MudLayout>

@code {
    private readonly MudTheme _theme = SilverbridgeTheme.Create();
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _themeInitialized;
    private ThemePreference _themePreference = ThemePreference.System;

    private static readonly string YouTubeUrl = GetYouTubeUrl();

    private string ThemeIcon => _themePreference switch
    {
        ThemePreference.Light => Icons.Material.Filled.LightMode,
        ThemePreference.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.Contrast
    };

    private string ThemeMenuLabel => $"Colour theme: {_themePreference}";

    protected override void OnInitialized()
    {
        ThemePreferenceService.SystemThemeChanged += HandleSystemThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        ThemePreferenceState state = await ThemePreferenceService.InitializeAsync();
        _themePreference = state.Preference;
        _isDarkMode = state.IsDarkMode;
        _themeInitialized = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemePreferenceService.SystemThemeChanged -= HandleSystemThemeChanged;
        GC.SuppressFinalize(this);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task SetThemePreferenceAsync(ThemePreference preference)
    {
        _themePreference = preference;
        _isDarkMode = await ThemePreferenceService.SetPreferenceAsync(preference);
    }

    private void HandleSystemThemeChanged(object? sender, SystemThemeChangedEventArgs args)
    {
        if (!_themeInitialized || _themePreference != ThemePreference.System)
        {
            return;
        }

        _isDarkMode = args.IsDarkMode;
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetPreferenceIcon(ThemePreference preference) =>
        preference == _themePreference
            ? Icons.Material.Filled.Check
            : preference switch
            {
                ThemePreference.Light => Icons.Material.Filled.LightMode,
                ThemePreference.Dark => Icons.Material.Filled.DarkMode,
                _ => Icons.Material.Filled.SettingsBrightness
            };

    private static string GetYouTubeUrl()
    {
        string? configuredUrl = Environment.GetEnvironmentVariable("YOUTUBE_URL");
        if (!string.IsNullOrWhiteSpace(configuredUrl))
        {
            return configuredUrl;
        }

        return new UriBuilder(Uri.UriSchemeHttps, "www.youtube.com")
        {
            Path = "@SilverbridgeHarpsGFC-oh6kb"
        }.Uri.AbsoluteUri;
    }
}
