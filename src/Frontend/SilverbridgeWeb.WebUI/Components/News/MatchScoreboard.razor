@* Displays a GAA-style scoreline (goals-points) for a match report article. *@

<section class="scoreboard" aria-label="@($"{HomeTeam} versus {AwayTeam} match score")">
    <div class="scoreboard__match">
        <div class="scoreboard__team">
            <span class="scoreboard__label">Home</span>
            <strong>@HomeTeam</strong>
        </div>
        <div class="scoreboard__score" aria-label="@($"{HomeTeam} {FormatScore(HomeGoals, HomePoints)}, {AwayTeam} {FormatScore(AwayGoals, AwayPoints)}")">
            <span>@FormatScore(HomeGoals, HomePoints)</span>
            <small aria-hidden="true">FT</small>
            <span>@FormatScore(AwayGoals, AwayPoints)</span>
        </div>
        <div class="scoreboard__team scoreboard__team--away">
            <span class="scoreboard__label">Away</span>
            <strong>@AwayTeam</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Competition) || !string.IsNullOrWhiteSpace(Venue) || MatchDateUtc.HasValue)
    {
        <div class="scoreboard__meta">
            @if (!string.IsNullOrWhiteSpace(Competition))
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" Size="Size.Small" aria-hidden="true" />@Competition</span>
            }
            @if (MatchDateUtc.HasValue)
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" aria-hidden="true" />@MatchDateUtc.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Venue))
            {
                <span><MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" aria-hidden="true" />@Venue</span>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string HomeTeam { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AwayTeam { get; set; } = string.Empty;

    [Parameter]
    public int HomeGoals { get; set; }

    [Parameter]
    public int HomePoints { get; set; }

    [Parameter]
    public int AwayGoals { get; set; }

    [Parameter]
    public int AwayPoints { get; set; }

    [Parameter]
    public string? Competition { get; set; }

    [Parameter]
    public string? Venue { get; set; }

    [Parameter]
    public DateTime? MatchDateUtc { get; set; }

    private static string FormatScore(int goals, int points) => $"{goals}-{points}";
}
