@using SilverbridgeWeb.WebUI.Services.ApiClients
@inject NewsApiClient NewsApiClient

<div class="recent-news">
    <SectionHeader Title="Latest from the club" Description="News, announcements and match-day stories from Silverbridge.">
        <Actions>
            <MudButton Href="/news" Variant="Variant.Text" Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.ArrowForward">
                All news
            </MudButton>
        </Actions>
    </SectionHeader>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading latest news" />
    }
    else if (_errorMessage is not null)
    {
        <StatePanel Title="News is unavailable"
                    Description="@_errorMessage"
                    Icon="@Icons.Material.Outlined.CloudOff"
                    IconColor="Color.Error"
                    Role="alert" />
    }
    else if (_articles.Count == 0)
    {
        <StatePanel Title="No news yet"
                    Description="Published club updates will appear here."
                    Icon="@Icons.Material.Outlined.Article" />
    }
    else
    {
        <div class="recent-news__grid">
            @foreach (NewsArticleSummaryResponse article in _articles)
            {
                <article class="news-card">
                    <MudCard Elevation="0" Class="news-card__surface">
                        <div class="news-card__media">
                            <div class="news-card__placeholder" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Newspaper" />
                            </div>
                        @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                        {
                            <img src="@article.FeaturedImageUrl" alt="" loading="lazy"
                                 onerror="this.hidden=true" />
                        }
                        </div>
                        <MudCardContent>
                            <div class="news-card__meta">
                                <span>@article.CategoryName</span>
                                @if (article.PublishedAtUtc.HasValue)
                                {
                                    <time datetime="@article.PublishedAtUtc.Value.ToString("O")">
                                        @article.PublishedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    </time>
                                }
                            </div>
                            <h3>@article.Title</h3>
                            @if (article.ArticleType == NewsArticleType.MatchReport)
                            {
                                <p class="news-card__score">
                                    @article.HomeTeam @FormatScore(article.HomeGoals, article.HomePoints)
                                    <span aria-hidden="true">—</span>
                                    @FormatScore(article.AwayGoals, article.AwayPoints) @article.AwayTeam
                                </p>
                            }
                            <p class="news-card__summary">@article.Summary</p>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/news/{article.Slug}")"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ArrowForward">
                                Read article
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int MaxArticles { get; set; } = 3;

    private List<NewsArticleSummaryResponse> _articles = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            NewsArticleListResponse? response = await NewsApiClient.GetArticlesAsync(
                page: 1,
                pageSize: MaxArticles,
                categoryId: null,
                includeAllStatuses: false);

            _articles = response?.Articles.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load news articles: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatScore(int? goals, int? points) => $"{goals ?? 0}-{points ?? 0}";
}
